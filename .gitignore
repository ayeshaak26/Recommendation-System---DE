# Secrets - never commit
.env
.streamlit/secrets.toml

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Data layers: raw + staged + quarantine are reproducible from the API, so keep them local.
# curated/ IS committed - the deployed Streamlit app reads from it.
data/raw/*
data/staged/*
data/quarantine/*
!data/**/.gitkeep

# Logs and dated papermill run reports
logs/*
!logs/.gitkeep
notebooks/reports/

# Tooling
.claude/
